{
  "manifest_version": 3,
  "name": "Usability Tracker — Local MVP",
  "version": "0.1.0",
  "description": "Opt-in usability tracking for websites you explicitly enable.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Usability Tracker", "default_popup": "popup.html" },
  "options_page": "options.html"
}
